#!/usr/bin/env bash
set -euo pipefail
LAB_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$LAB_ROOT"

usage() {
  echo "Usage: ./scripts/lab {test AA-SS|verify AA|verify all|status|doctor}"
}
[[ $# -ge 1 ]] || { usage; exit 2; }
command="$1"
shift
case "$command" in
  test)
    [[ $# -eq 1 && "$1" =~ ^(0[1-9]|1[0-2])-[0-9]{2}$ ]] || { usage; exit 2; }
    if ! awk -F, -v step="$1" '$1 == step { found=1 } END { exit !found }' lab-steps.csv; then
      echo "Unknown step: $1" >&2
      exit 2
    fi
    exec ./gradlew --no-daemon :banking-lab-tests:assignmentTest -PlabStep="$1"
    ;;
  verify)
    [[ $# -eq 1 ]] || { usage; exit 2; }
    if [[ "$1" == all ]]; then
      exec ./gradlew --no-daemon :banking-lab-tests:regressionTest
    elif [[ "$1" =~ ^(0[1-9]|1[0-2])$ ]]; then
      exec ./gradlew --no-daemon :banking-lab-tests:regressionTest -PlabThrough="$1"
    else
      usage; exit 2
    fi
    ;;
  status)
    [[ $# -eq 0 ]] || { usage; exit 2; }
    exec ./gradlew --no-daemon :banking-lab-tests:labStatus
    ;;
  doctor)
    [[ $# -eq 0 ]] || { usage; exit 2; }
    command -v java >/dev/null || { echo "ENVIRONMENT_ERROR: Java 21 is required" >&2; exit 1; }
    java -version
    ./gradlew --version
    command -v docker >/dev/null || { echo "ENVIRONMENT_ERROR: Docker CLI is required" >&2; exit 1; }
    docker info --format 'Docker server: {{.ServerVersion}}' ||
      { echo "ENVIRONMENT_ERROR: Docker daemon is unavailable or inaccessible" >&2; exit 1; }
    exec ./gradlew --no-daemon :banking-lab-tests:environmentTest
    ;;
  *) usage; exit 2 ;;
esac
